{
	"extends": "./tsconfig.node.json",
	"compilerOptions": {
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["src/node/**/*.ts", "src/shared/**/*.ts"]
}
